<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      v0.3 起唯一新增的权限：内置浏览器导入教务课表。
      打破「零联网」是 v0.3 需求冻结时明确确认过的取舍 ——
      导入流程全程由用户手动完成（登录密码不经过本应用），
      应用自身不做任何网络请求，Cookie 在页面关闭时立即清除。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ObsessionApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obsession">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Obsession"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              v0.4 分享与文件关联。
              SEND：微信/QQ/网盘的「发送文件」（text/html 流）分享菜单里可选 Obsession；
              VIEW：MT 管理器等文件管理器「打开方式」可选中 Obsession 直接导入。
              都汇到 MainActivity 的 handleImportIntent，与「选文件」走同一解析通道。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="text/html" />
                <data android:scheme="file" android:mimeType="text/html" />
            </intent-filter>
            <!-- 扩展名兜底：.mhtml / .mht 等常被识别成 octet-stream 或 message/rfc822 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
                <data android:scheme="file" android:mimeType="*/*" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\.htm" />
                <data android:pathPattern=".*\\.mhtml" />
                <data android:pathPattern=".*\\.mht" />
                <data android:pathPattern=".*\\..*\\.html" />
                <data android:pathPattern=".*\\..*\\.htm" />
                <data android:pathPattern=".*\\..*\\.mhtml" />
                <data android:pathPattern=".*\\..*\\.mht" />
            </intent-filter>
        </activity>

        <!-- 内置浏览器导入。仅应用内部跳转可达 -->
        <activity
            android:name=".browser.BrowserImportActivity"
            android:exported="false"
            android:theme="@style/Theme.Obsession"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
          桌面小组件。exported 保持 false：APPWIDGET_UPDATE 是系统受保护广播，
          系统进程能送达，第三方应用发了也不会被接收。
        -->
        <receiver
            android:name=".widget.WeekWidgetProvider"
            android:exported="false"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <receiver
            android:name=".widget.DayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_info" />
        </receiver>

        <receiver
            android:name=".widget.UpcomingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_upcoming_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_info" />
        </receiver>

        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:exported="false"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <!-- 小组件 ListView 的行工厂（系统按需拉取，BIND_REMOTEVIEWS 权限保护） -->
        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 零点兜底刷新（配 DATE_CHANGED 广播）。显式 Intent 触发，无需 filter -->
        <receiver
            android:name=".MidnightRefreshReceiver"
            android:exported="false" />
    </application>

</manifest>
