        android:layout_margin="1dp">
        <ImageView android:id="@+id/wk_c6_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_card_shape" />
        <ImageView android:id="@+id/wk_c6_st" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_stroke_shape" android:visibility="gone" />
