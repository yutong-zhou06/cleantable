            <TextView android:id="@+id/wk_c2_r" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/w_text_dim" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

