        <ImageView android:id="@+id/wk_c2_em" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_cell_empty" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="4dp">
