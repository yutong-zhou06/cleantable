<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 今日课程紧凑版。

  排版要点（这里是「不显拥挤」的关键，别改回去）：
  · 三个课程位用 layout_height=0dp + layout_weight=1 **等分撑满**可用高度，
    内容在各自格子里垂直居中 —— 而不是 wrap_content 全挤在顶部、底部留一大块空白。
  · 色条 ImageView 用 match_parent 高度，父行必须是 0dp+weight 才会被精确测量；
    父行若写 wrap_content，色条会量到 0 高度而消失。
  · includeFontPadding=false 收掉字体自带的额外行距，两行文字之间才留得出真正的间隙。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_root_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 头部：极小字一行（无图标） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cmp_head_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cmp_head_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/w_text_dim" />
    </LinearLayout>

    <!-- 主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 空状态：与课程位互斥 -->
        <TextView
            android:id="@+id/cmp_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_compact_empty"
            android:textColor="@color/w_text_faint" />

        <!-- 课程位 1 -->
        <LinearLayout
            android:id="@+id/cmp_1_slot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cmp_1_bar"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/w_bar_shape" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cmp_1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cmp_1_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_text_dim" />
            </LinearLayout>
        </LinearLayout>

        <!-- 课程位 2 -->
        <LinearLayout
            android:id="@+id/cmp_2_slot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cmp_2_bar"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/w_bar_shape" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cmp_2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cmp_2_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_text_dim" />
            </LinearLayout>
        </LinearLayout>

        <!-- 课程位 3 -->
        <LinearLayout
            android:id="@+id/cmp_3_slot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cmp_3_bar"
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/w_bar_shape" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cmp_3_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cmp_3_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/w_text_dim" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
