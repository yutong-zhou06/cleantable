<?xml version="1.0" encoding="utf-8"?>
<!-- 今日课程 2×2：极小头部 + 今日课程列表（上下滚动） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_root_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="11dp"
        android:paddingTop="8dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/cp_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/w_text"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cp_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/w_text_dim"
            android:maxLines="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/cp_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical"
            android:scrollbarSize="2dp"
            android:paddingHorizontal="11dp"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/cp_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_compact_empty"
            android:textSize="11sp"
            android:textColor="@color/w_text_faint"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
