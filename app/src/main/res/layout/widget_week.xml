<?xml version="1.0" encoding="utf-8"?>
<!-- 周视图 4×2：头部 + 星期栏（固定）+ 课程列表（上下滚动，行=行槽，格子等大） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_root_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/w_text"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/week_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textColor="@color/w_text_dim"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/week_ic_set"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:padding="2dp"
            android:src="@drawable/ic_w_settings" />

        <ImageView
            android:id="@+id/week_ic_open"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:padding="2dp"
            android:src="@drawable/ic_w_open" />
    </LinearLayout>

    <!-- 星期栏：固定不随列表滚动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/week_head_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_mon"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />

        <TextView
            android:id="@+id/week_head_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_tue"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />

        <TextView
            android:id="@+id/week_head_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_wed"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />

        <TextView
            android:id="@+id/week_head_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_thu"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />

        <TextView
            android:id="@+id/week_head_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_fri"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />

        <TextView
            android:id="@+id/week_head_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_sat"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />

        <TextView
            android:id="@+id/week_head_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wd_sun"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/w_text_dim"
            android:gravity="center" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/week_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical"
            android:scrollbarSize="2dp"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/week_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_week_empty"
            android:textSize="12sp"
            android:textColor="@color/w_text_faint"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
